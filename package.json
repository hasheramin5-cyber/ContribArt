{
  "name": "contribart",
  "version": "1.0.0",
  "description": "Generate customizable SVG artwork from your GitHub contribution graph.",
  "main": "dist/index.js",
  "scripts": {
    "prestart" : "npm run format && npm run build",
    "start": "( node dist/index.js )",
    "build": "tsc && ncc -m build lib/main.js",
    "format": "prettier --write **/*.ts"
  },
  "keywords": [
    "github",
    "contribution-graph",
    "svg",
    "github-actions",
    "profile-readme"
  ],
  "author": "Hasher Amin",
  "license": "BSD-3-Clause",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^5.1.1"
  },
  "devDependencies": {
    "@types/node": "^18.14.2",
    "@vercel/ncc": "^0.45.0",
    "node-html-parser": "^9.0.7",
    "prettier": "^2.8.4",
    "typescript": "^4.9.5"
  }
}
